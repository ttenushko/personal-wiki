# ── Telegram ──────────────────────────────────────────────
# Токен от @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# ── OpenRouter (LLM) ──────────────────────────────────────
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Модель (можно сменить на другую бесплатную/платную)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Провайдеры LLM (JSON-список) — пробуются по порядку до первого успеха.
# Поля: provider ("openrouter" | "opencode"), model, api_key, base_url,
# username (opencode), password (opencode). Если список пуст — используется
# OPENROUTER_MODEL + OPENROUTER_API_KEY.
# Пример:
# LLM_PROVIDERS=[{"provider":"openrouter","model":"openai/gpt-oss-20b:free","api_key":"sk-..."},{"provider":"opencode","model":"opencode/big-pickle","base_url":"http://127.0.0.1:62117","username":"opencode","password":"твой-пароль"}]
#
# Qwen (DashScope / Alibaba Cloud, OpenAI-совместимый API):
#   model: qwen3.7-plus, qwen-plus, qwen-max и т.д.
#   api_key: твой DashScope API key (https://bailian.console.alibabacloud.com)
#   base_url: https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (международный)
#             или https://dashscope.aliyuncs.com/compatible-mode/v1 (Китай)
#   Пример: LLM_PROVIDERS=[{"provider":"openrouter","model":"qwen3.7-plus","api_key":"sk-...","base_url":"https://dashscope-intl.aliyuncs.com/compatible-mode/v1"}]
#
# Локальная Ollama (бесплатно, работает офлайн): https://ollama.com
#   model: qwen3:4b, llama3.2 и т.д. (скачай: ollama pull qwen3:4b)
#   base_url: http://127.0.0.1:11434/v1
#   api_key: любой (например "ollama")
#   Пример: LLM_PROVIDERS=[{"provider":"ollama","model":"qwen3:4b","base_url":"http://127.0.0.1:11434/v1","api_key":"ollama"}]
LLM_PROVIDERS=[]

# ── GitHub (синк вики) ─────────────────────────────────────
# Personal Access Token с правами repo: https://github.com/settings/tokens
# Пустое значение = работать только локально (папка pages/)
GITHUB_TOKEN=
# Формат: username/repo
GITHUB_REPO=username/personal-wiki-vault
GITHUB_BRANCH=main

# ── Хранилище страниц ──────────────────────────────────────
# Локальная папка с .md-страницами (создаётся автоматически)
WIKI_PAGES_DIR=pages
# Папка, куда wiki build кладёт статический HTML
WIKI_SITE_DIR=site

# ── Google Drive (опционально, для тяжёлых файлов) ───────
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=

# ── Веб-интерфейс (только для wikillm-server) ────────────
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_SECRET_KEY=change-me-in-production
# Пароль для входа в веб
WEB_PASSWORD=admin
